   "source": [
    "\"\"\"\n",
    "Data Analysys for Bordeaux real estate dataset\n",
    "Generate plots and save them to results/figures/\n",
    "\"\"\"\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from pathlib import Path\n",
    "\n",
    "# style\n",
    "sns.set_style(\"whitegrid\")\n",
    "plt.rcParams['figure.figsize'] = (10, 6)\n",
    "\n",
    "def load_cleaned_data(filepath='data/processed/bordeaux_clean.csv'):\n",
    "    \"\"\"Load clean dataset\"\"\"\n",
    "    base_dir = Path(__file__).resolve().parent.parent\n",
    "    csv_path = base_dir / filepath\n",
    "    df = pd.read_csv(csv_path)\n",
    "    print(f\"Loaded cleaned data with shape: {df.shape}\")\n",
    "    return df\n",
    "\n",
    "def save_plot(fig, filename, dpi=300):\n",
    "    \"\"\"Save a matplotlib figure to results/figures/\"\"\"\n",
    "    base_dir = Path(__file__).resolve().parent.parent\n",
    "    fig_dir = base_dir / 'results' / 'figures'\n",
    "    fig_dir.mkdir(parents=True, exist_ok=True)\n",
    "    fig_path = fig_dir / filename\n",
    "    fig.savefig(fig_path, dpi=dpi, bbox_inches='tight')\n",
    "    print(f\"Saved figure: {fig_path}\")\n",
    "    plt.close(fig) # Free memory\n",
    "\n",
    "def plot_price_distribution(df):\n",
    "    \"\"\"Histogram of price per m²\"\"\"\n",
    "    fig, ax = plt.subplots()\n",
    "    sns.histplot(df['prix_m2'], bins=50, kde=True, ax=ax, color='skyblue')\n",
    "    ax.set_title('Distribution of Price per Square Meter (â‚¬/mÂ²)')\n",
    "    ax.set_xlabel('Price per m²(â‚¬mÂ²)')\n",
    "    ax.set_ylabel('Frequency')\n",
    "    save_plot(fig, 'price_distribution.png')\n",
    "\n",
    "def plot_price_by_property_type(df):\n",
    "    \"\"\"Plot boxplot of price per square meter by property type.\"\"\"\n",
    "    fig, ax = plt.subplots()\n",
    "    # Order by median price for better visualization\n",
    "    order = df.groupby('type_local')['prix_m2'].median().sort_values().index\n",
    "    sns.boxplot(x='type_local', y='prix_m2', data=df, order=order, ax=ax, palette='Set2')\n",
    "    ax.set_title('Price per Square Meter by Property Type')\n",
    "    ax.set_xlabel('Property Type')\n",
    "    ax.set_ylabel('Price per mÂ² (â‚¬)')\n",
    "    ax.tick_params(axis='x', rotation=45)\n",
    "    save_plot(fig, 'price_by_property_type.png')\n",
    "\n",
    "def plot_price_by_postal_code(df, top_n=10):\n",
    "    \"\"\"Plot bar chart of average price per square meter for top N postal codes.\"\"\"\n",
    "    # Calculate average price per postal code\n",
    "    avg_price_by_postal = df.groupby('code_postal')['prix_m2'].mean().sort_values(ascending=False)\n",
    "    # Take top N\n",
    "    top_postal = avg_price_by_postal.head(top_n)\n",
    "\n",
    "    fig, ax = plt.subplots()\n",
    "    sns.barplot(x=top_postal.index, y=top_postal.values, ax=ax, palette='viridis')\n",
    "    ax.set_title(f'Top {top_n} Postal Codes by Average Price per mÂ²')\n",
    "    ax.set_xlabel('Postal Code')\n",
    "    ax.set_ylabel('Average Price per mÂ² (â‚¬)')\n",
    "    ax.tick_params(axis='x', rotation=45)\n",
    "    save_plot(fig, f'price_by_top{top_n}_postal_codes.png')\n",
    "\n",
    "def plot_correlation_heatmap(df):\n",
    "    \"\"\"Plot heatmap of correlations between key numerical variables.\"\"\"\n",
    "    # Select numerical columns for correlation\n",
    "    numerical_cols = ['prix_m2', 'surface_reelle_bati', 'nombre_pieces_principales',\n",
    "                      'latitude', 'longitude', 'valeur_fonciere']\n",
    "    # Ensure columns exist\n",
    "    numerical_cols = [col for col in numerical_cols if col in df.columns]\n",
    "    corr_df = df[numerical_cols].corr()\n",
    "\n",
    "    fig, ax = plt.subplots()\n",
    "    sns.heatmap(corr_df, annot=True, fmt=\".2f\", cmap='coolwarm', center=0,\n",
    "                square=True, linewidths=0.5, cbar_kws={\"shrink\": .8}, ax=ax)\n",
    "    ax.set_title('Correlation Heatmap of Key Variables')\n",
    "    save_plot(fig, 'correlation_heatmap.png')\n",
    "\n",
    "def main():\n",
    "    \"\"\"Main EDA function.\"\"\"\n",
    "    print(\"Starting Exploratory Data Analysis...\")\n",
    "    df = load_cleaned_data()\n",
    "\n",
    "    # Generate plots\n",
    "    plot_price_distribution(df)\n",
    "    plot_price_by_property_type(df)\n",
    "    plot_price_by_postal_code(df, top_n=10)\n",
    "    plot_correlation_heatmap(df)\n",
    "\n",
    "    print(\"EDA completed. Figures saved to results/figures/\")\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    main()"
   ]
  }
 ],
